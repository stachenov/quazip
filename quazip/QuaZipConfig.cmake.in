@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/@QUAZIP_EXPORT_SET@.cmake")

if(@QUAZIP_QT_MAJOR_VERSION@ EQUAL 6)
	find_dependency(Qt6 REQUIRED COMPONENTS Core Core5Compat)
elseif(@QUAZIP_QT_MAJOR_VERSION@ EQUAL 5)
	find_dependency(Qt5 REQUIRED COMPONENTS Core)
else()
    message(FATAL_ERROR "Qt version QUAZIP_QT_MAJOR_VERSION=@QUAZIP_QT_MAJOR_VERSION@ is unsupported")
endif()

if(@QUAZIP_BZIP2@ AND NOT @QUAZIP_BZIP2_BUILD@)
    find_dependency(BZip2 REQUIRED)
endif()

if(@QUAZIP_USE_QT_ZLIB@)
    find_dependency(Qt@QUAZIP_QT_MAJOR_VERSION@ REQUIRED COMPONENTS @QUAZIP_QT_ZLIB_COMPONENT@)
else()
    find_dependency(ZLIB REQUIRED)
endif()

foreach(_quazip_target QuaZip::QuaZip QuaZip::QuaZip_static)
    if(TARGET ${_quazip_target})
        get_target_property(_quazip_global ${_quazip_target} IMPORTED_GLOBAL)
        # Repeated find_package calls may see a target created in another directory.
        if(NOT _quazip_global)
            set_target_properties(${_quazip_target} PROPERTIES IMPORTED_GLOBAL TRUE)
        endif()
    endif()
endforeach()
unset(_quazip_target)
unset(_quazip_global)

check_required_components(@QUAZIP_PACKAGE_NAME@)
